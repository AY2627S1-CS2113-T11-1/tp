%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 4 4; }", "themeVariables": {"fontSize": "20px", "actorBkg": "#f4f4f4", "actorBorder": "#333333", "actorTextColor": "#111111", "actorLineColor": "#666666", "signalColor": "#333333", "signalTextColor": "#111111", "activationBkgColor": "#e0e0e0", "activationBorderColor": "#333333"}}}%%
sequenceDiagram
    participant D as : Duke
    participant P as : Parser
    participant O as : OrderList
    participant E as : ExpenseList
    participant U as : Ui
    activate D
    D->>P: parse(...)
    activate P
    create participant C as : FinancesCommand
    P->>C: create
    activate C
    P-->>D: FinancesCommand
    deactivate P
    D->>C: execute(...)
    C->>O: getAll()
    activate O
    O-->>C: active orders
    deactivate O
    C->>O: getPaidSales()
    activate O
    O-->>C: active orders with payments
    deactivate O
    C->>E: getExpenses()
    activate E
    E-->>C: expense records
    deactivate E
    C->>U: show financial report
    activate U
    U-->>D: financial report
    deactivate U
    deactivate C
    destroy C
    deactivate D
