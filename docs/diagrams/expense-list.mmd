%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 4 4; }", "themeVariables": {"fontSize": "20px", "actorBkg": "#f4f4f4", "actorBorder": "#333333", "actorTextColor": "#111111", "actorLineColor": "#666666", "signalColor": "#333333", "signalTextColor": "#111111", "activationBkgColor": "#e0e0e0", "activationBorderColor": "#333333"}}}%%
sequenceDiagram
    participant D as : Duke
    participant P as : Parser
    participant L as : ExpenseList
    participant U as : Ui

    activate D
    D->>P: parse(...)
    activate P
    create participant C as : ListExpenseCommand
    P->>C: create
    activate C
    P-->>D: ListExpenseCommand
    deactivate P
    D->>C: execute(...)
    C->>L: getExpenses()
    activate L
    L-->>C: copy of expense records
    deactivate L
    C->>U: show expenses
    activate U
    U-->>D: numbered list
    deactivate U
    deactivate C
    destroy C
    deactivate D
