sequenceDiagram
    actor User
    participant P as Parser
    participant C as FinancesCommand
    participant O as OrderList
    participant E as ExpenseList
    participant U as Ui
    activate User
    User->>P: finances
    activate P
    P-->>C: FinancesCommand
    deactivate P
    activate C
    C->>O: getAll()
    activate O
    O-->>C: active orders
    deactivate O
    C->>O: getPaidSales()
    activate O
    O-->>C: active orders with payments
    deactivate O
    C->>E: getExpenses()
    activate E
    E-->>C: expense records
    deactivate E
    C->>U: show financial report
    activate U
    U-->>User: financial report
    deactivate U
    deactivate C
    deactivate User
