%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 4 4; }", "themeVariables": {"fontSize": "20px", "actorBkg": "#dbeafe", "actorBorder": "#2563eb", "actorTextColor": "#1e3a8a", "actorLineColor": "#60a5fa", "signalColor": "#2563eb", "signalTextColor": "#1e3a8a", "activationBkgColor": "#bfdbfe", "activationBorderColor": "#2563eb"}}}%%
sequenceDiagram
    participant P as parser : Parser
    participant C as command : FinancesCommand
    participant O as orders : OrderList
    participant E as expenses : ExpenseList
    participant U as ui : Ui

    P->>C: create()
    activate C
    C->>O: getAll()
    activate O
    O-->>C: active orders
    deactivate O
    C->>O: getPaidSales()
    activate O
    O-->>C: active orders with payments
    deactivate O
    C->>E: getExpenses()
    activate E
    E-->>C: expense records
    deactivate E
    C->>U: showFinances(orders, payments, expenses)
    activate U
    U-->>C: return
    deactivate U
    deactivate C
