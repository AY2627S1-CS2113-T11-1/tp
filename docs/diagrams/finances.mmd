%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 5 5; }", "themeVariables": {"fontSize": "20px", "actorBkg": "#eef4fb", "actorBorder": "#40566f", "actorTextColor": "#1f2933", "actorLineColor": "#8a98a8", "signalColor": "#40566f", "signalTextColor": "#1f2933", "activationBkgColor": "#ffffff", "activationBorderColor": "#40566f"}}}%%
sequenceDiagram
    participant D as : Duke
    participant P as : Parser
    participant O as : OrderList
    participant E as : ExpenseList
    participant U as : Ui
    activate D
    D->>P: parse(...)
    activate P
    create participant C as : FinancesCommand
    P->>C: create
    activate C
    P-->>D: FinancesCommand
    deactivate P
    D->>C: execute(...)
    C->>O: getAll()
    activate O
    O-->>C: active orders
    deactivate O
    C->>O: getPaidSales()
    activate O
    O-->>C: active orders with payments
    deactivate O
    C->>E: getExpenses()
    activate E
    E-->>C: expense records
    deactivate E
    C->>U: show financial report
    activate U
    U-->>D: financial report
    deactivate U
    deactivate C
    destroy C
    deactivate D
