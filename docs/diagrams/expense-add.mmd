sequenceDiagram
    participant P as parser : Parser
    participant C as command : AddExpenseCommand
    participant E as expense : Expense
    participant L as expenses : ExpenseList
    participant U as ui : Ui

    P->>C: create(product, amount)
    activate C
    C->>E: create(product, amount)
    activate E
    E-->>C: validated expense
    deactivate E
    C->>L: add(expense)
    activate L
    L-->>C: expense added
    deactivate L
    C->>U: showConfirmation(expense)
    activate U
    U-->>C: return
    deactivate U
    deactivate C
