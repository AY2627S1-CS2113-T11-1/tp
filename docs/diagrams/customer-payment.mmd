%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 4 4; } .loopLine { stroke-dasharray: none !important; }", "themeVariables": {"actorBkg": "#dbeafe", "actorBorder": "#2563eb", "actorTextColor": "#1e3a8a", "actorLineColor": "#60a5fa", "signalColor": "#2563eb", "signalTextColor": "#1e3a8a", "activationBkgColor": "#bfdbfe", "activationBorderColor": "#2563eb"}}}%%
sequenceDiagram
    %% Partial payments are allocated across eligible orders in creation order.
    participant C as command : AddPaymentCommand
    participant L as orders : OrderList
    participant O as order : Order
    participant U as ui : Ui
    activate C
    C->>L: getAll()
    activate L
    L-->>C: order history
    deactivate L
    loop Each eligible unpaid order
        C->>O: getAmountDue()
        activate O
        O-->>C: due
        deactivate O
        C->>O: recordPayment(min(remaining, due))
        activate O
        O-->>C: payment recorded
        deactivate O
    end
    C->>U: showPayment(amount, balance, change)
    activate U
    U-->>C: return
    deactivate U
    deactivate C
