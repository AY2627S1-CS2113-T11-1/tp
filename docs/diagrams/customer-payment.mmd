%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 5 5; } .loopLine { stroke-dasharray: none !important; }", "themeVariables": {"actorBkg": "#eef4fb", "actorBorder": "#40566f", "actorTextColor": "#1f2933", "actorLineColor": "#8a98a8", "signalColor": "#40566f", "signalTextColor": "#1f2933", "activationBkgColor": "#ffffff", "activationBorderColor": "#40566f"}}}%%
sequenceDiagram
    %% Partial payments are allocated across eligible orders in creation order.
    participant C as command : AddPaymentCommand
    participant L as orders : OrderList
    participant O as order : Order
    participant U as ui : Ui
    activate C
    C->>L: getAll()
    activate L
    L-->>C: order history
    deactivate L
    loop Each eligible unpaid order
        C->>O: getAmountDue()
        activate O
        O-->>C: due
        deactivate O
        C->>O: recordPayment(min(remaining, due))
        activate O
        O-->>C: payment recorded
        deactivate O
    end
    C->>U: showPayment(amount, balance, change)
    activate U
    U-->>C: return
    deactivate U
    deactivate C
