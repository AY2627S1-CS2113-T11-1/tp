sequenceDiagram
    participant D as :Duke
    participant P as :Parser
    participant C as :LowStockCommand
    participant SL as :StockList
    participant PL as :ProductList
    participant U as :Ui

    D->>P: parse(command)
    activate P
    P->>C: LowStockCommand(threshold)
    activate C
    C-->>P: parsedCommand
    deactivate C
    P-->>D: parsedCommand
    deactivate P

    D->>C: execute(...)
    activate C

    C->>SL: getStocks()
    activate SL
    SL-->>C: allStocks
    deactivate SL

    loop for each stock in allStocks
        C->>PL: findByName(stock.product)
        activate PL
        PL-->>C: product
        deactivate PL
    end

    C->>U: showLowStock(lowStocks, threshold, isStockListEmpty)
    activate U
    U-->>C: 
    deactivate U

    C-->>D: 
    deactivate C
