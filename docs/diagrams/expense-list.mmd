%%{init: {"themeVariables": {"fontSize": "20px"}}}%%
sequenceDiagram
    actor User as : User
    participant D as : Duke
    participant P as : Parser
    participant C as : ListExpenseCommand
    participant L as : ExpenseList
    participant U as : Ui

    activate User
    User->>D: expense list
    activate D
    D->>P: parse(...)
    activate P
    P->>C: create
    activate C
    P-->>D: ListExpenseCommand
    deactivate P
    D->>C: execute(...)
    C->>L: getExpenses()
    activate L
    L-->>C: copy of expense records
    deactivate L
    C->>U: show expenses
    activate U
    U-->>User: numbered list
    deactivate U
    deactivate C
    destroy C
    deactivate D
    deactivate User
