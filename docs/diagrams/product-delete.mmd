sequenceDiagram
    %% Deleting "Bread" with `product delete p/Bread`.
    %% Mermaid cannot draw UML's destroy marker, so docs/diagrams/render.py adds the X where
    %% :DeleteProductCommand's lifeline ends. Re-render with: python3 docs/diagrams/render.py product-delete
    actor User
    participant D as :Duke
    participant P as :Parser

    User->>D: product delete p/Bread
    activate D
    D->>P: parse("product delete p/Bread")
    activate P
    P->>P: parseDeleteProduct("p/Bread")
    activate P
    create participant C as :DeleteProductCommand
    P->>C: DeleteProductCommand("Bread")
    activate C
    C-->>P: 
    deactivate C
    P-->>P: command
    deactivate P
    P-->>D: command
    deactivate P

    D->>C: execute(products, orders, expenses, stocks, ui)
    activate C
    participant PL as :ProductList
    participant OL as :OrderList
    participant SL as :StockList
    participant UI as :Ui
    C->>PL: findByName("Bread")
    activate PL
    PL-->>C: product
    deactivate PL
    C->>OL: findActiveOrderWithProduct("Bread")
    activate OL
    OL-->>C: activeOrder
    deactivate OL

    alt activeOrder != null
        C-->>D: SystemException
    else else
        C->>PL: remove(product)
        activate PL
        PL-->>C: 
        deactivate PL
        C->>SL: removeByProduct("Bread")
        activate SL
        SL-->>C: hadStockEntry
        deactivate SL
        C->>UI: showProductDeleted(product)
        activate UI
        UI-->>C: 
        deactivate UI
        C-->>D: 
    end
    deactivate C
    D->>C: isExit()
    activate C
    destroy C
    C-->>D: false
    deactivate C
    deactivate D
