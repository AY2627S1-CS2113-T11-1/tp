sequenceDiagram
    actor User as user : User
    participant D as duke : Duke
    participant P as parser : Parser
    participant C as financesCommand : FinancesCommand
    participant O as orderList : OrderList
    participant E as expenseList : ExpenseList
    participant U as ui : Ui
    activate User
    User->>D: finances
    activate D
    D->>P: parse(...)
    activate P
    P->>C: <<create>> FinancesCommand()
    activate C
    P-->>D: FinancesCommand
    deactivate P
    D->>C: execute(...)
    C->>O: getAll()
    activate O
    O-->>C: active orders
    deactivate O
    C->>O: getPaidSales()
    activate O
    O-->>C: active orders with payments
    deactivate O
    C->>E: getExpenses()
    activate E
    E-->>C: expense records
    deactivate E
    C->>U: show financial report
    activate U
    U-->>User: financial report
    deactivate U
    deactivate C
    destroy C
    deactivate D
    deactivate User
