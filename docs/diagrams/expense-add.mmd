%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 4 4; }", "themeVariables": {"fontSize": "20px", "actorBkg": "#f4f4f4", "actorBorder": "#333333", "actorTextColor": "#111111", "actorLineColor": "#666666", "signalColor": "#333333", "signalTextColor": "#111111", "activationBkgColor": "#e0e0e0", "activationBorderColor": "#333333"}}}%%
sequenceDiagram
    participant D as : Duke
    participant P as : Parser
    participant C as : AddExpenseCommand
    participant L as : ExpenseList
    participant U as : Ui

    activate D
    D->>P: parse(...)
    activate P
    P->>C: create
    activate C
    create participant E as : Expense
    C->>E: create
    activate E
    E-->>C: created expense
    deactivate E
    destroy E
    C-->>D: AddExpenseCommand
    deactivate P
    D->>C: execute(...)
    C->>L: add Expense
    activate L
    L-->>C: added
    deactivate L
    C->>U: show confirmation
    activate U
    U-->>D: Expense added
    deactivate U
    deactivate C
    destroy C
    deactivate D
