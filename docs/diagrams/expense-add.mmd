%%{init: {"themeVariables": {"fontSize": "20px"}}}%%
sequenceDiagram
    actor User as : User
    participant D as : Duke
    participant P as : Parser
    participant C as : AddExpenseCommand
    participant E as : Expense
    participant L as : ExpenseList
    participant U as : Ui

    activate User
    User->>D: expense add p/Bread a/100.50
    activate D
    D->>P: parse(...)
    activate P
    P->>C: create
    activate C
    C->>E: create
    activate E
    E-->>C: created expense
    deactivate E
    C-->>D: AddExpenseCommand
    deactivate P
    D->>C: execute(...)
    C->>L: add Expense
    activate L
    L-->>C: added
    deactivate L
    C->>U: show confirmation
    activate U
    U-->>User: Expense added
    deactivate U
    deactivate C
    destroy C
    deactivate D
    deactivate User
