%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 4 4; } .loopLine { stroke-dasharray: none !important; }", "themeVariables": {"actorBkg": "#f4f4f4", "actorBorder": "#333333", "actorTextColor": "#111111", "actorLineColor": "#666666", "signalColor": "#333333", "signalTextColor": "#111111", "activationBkgColor": "#e0e0e0", "activationBorderColor": "#333333"}}}%%
sequenceDiagram
    %% Partial payments are allocated across eligible orders in creation order.
    participant C as command : AddPaymentCommand
    participant L as orders : OrderList
    participant O as order : Order
    participant U as ui : Ui
    activate C
    C->>L: getAll()
    activate L
    L-->>C: order history
    deactivate L
    loop Each eligible unpaid order
        C->>O: getAmountDue()
        activate O
        O-->>C: due
        deactivate O
        C->>O: recordPayment(min(remaining, due))
        activate O
        O-->>C: payment recorded
        deactivate O
    end
    C->>U: showPayment(amount, balance, change)
    activate U
    U-->>C: return
    deactivate U
    deactivate C
