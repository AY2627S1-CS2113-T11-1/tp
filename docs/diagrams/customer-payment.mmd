%%{init: {"themeCSS": ".loopLine { stroke-dasharray: none !important; }"}}%%
sequenceDiagram
    %% Partial payments are allocated across eligible orders in creation order.
    actor D as user : User
    participant C as command : AddPaymentCommand
    participant L as orders : OrderList
    participant O as order : Order
    participant U as ui : Ui
    D->>C: execute(...)
    activate C
    C->>L: getAll()
    activate L
    L-->>C: order history
    deactivate L
    loop Each eligible unpaid order
        C->>O: getAmountDue()
        activate O
        O-->>C: due
        deactivate O
        C->>O: recordPayment(min(remaining, due))
        activate O
        O-->>C: payment recorded
        deactivate O
    end
    C->>U: showPayment(amount, balance, change)
    activate U
    U-->>C: return
    deactivate U
    C-->>D: return
    deactivate C
