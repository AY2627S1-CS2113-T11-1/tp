%%{init: {"themeVariables": {"fontSize": "20px"}}}%%
sequenceDiagram
    actor User as : User
    participant D as : Duke
    participant P as : Parser
    participant C as : FinancesCommand
    participant O as : OrderList
    participant E as : ExpenseList
    participant U as : Ui
    activate User
    User->>D: finances
    activate D
    D->>P: parse(...)
    activate P
    P->>C: create
    activate C
    P-->>D: FinancesCommand
    deactivate P
    D->>C: execute(...)
    C->>O: getAll()
    activate O
    O-->>C: active orders
    deactivate O
    C->>O: getPaidSales()
    activate O
    O-->>C: active orders with payments
    deactivate O
    C->>E: getExpenses()
    activate E
    E-->>C: expense records
    deactivate E
    C->>U: show financial report
    activate U
    U-->>User: financial report
    deactivate U
    deactivate C
    destroy C
    deactivate D
    deactivate User
