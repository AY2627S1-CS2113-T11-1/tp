%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 5 5; }", "themeVariables": {"fontSize": "20px", "actorBkg": "#eef4fb", "actorBorder": "#40566f", "actorTextColor": "#1f2933", "actorLineColor": "#8a98a8", "signalColor": "#40566f", "signalTextColor": "#1f2933", "activationBkgColor": "#ffffff", "activationBorderColor": "#40566f"}}}%%
sequenceDiagram
    participant D as : Duke
    participant P as : Parser
    participant C as : AddExpenseCommand
    participant L as : ExpenseList
    participant U as : Ui

    activate D
    D->>P: parse(...)
    activate P
    P->>C: create
    activate C
    create participant E as : Expense
    C->>E: create
    activate E
    E-->>C: created expense
    deactivate E
    destroy E
    C-->>D: AddExpenseCommand
    deactivate P
    D->>C: execute(...)
    C->>L: add Expense
    activate L
    L-->>C: added
    deactivate L
    C->>U: show confirmation
    activate U
    U-->>D: Expense added
    deactivate U
    deactivate C
    destroy C
    deactivate D
