%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 5 5; }", "themeVariables": {"fontSize": "20px", "actorBkg": "#eef4fb", "actorBorder": "#40566f", "actorTextColor": "#1f2933", "actorLineColor": "#8a98a8", "signalColor": "#40566f", "signalTextColor": "#1f2933", "activationBkgColor": "#ffffff", "activationBorderColor": "#40566f"}}}%%
sequenceDiagram
    participant C as command : FinancesCommand
    participant O as orders : OrderList
    participant E as expenses : ExpenseList
    participant U as ui : Ui
    activate C
    C->>O: getConfirmedSales()
    activate O
    O-->>C: confirmed orders
    deactivate O
    C->>O: getPaidSales()
    activate O
    O-->>C: paid sales
    deactivate O
    C->>E: getExpenses()
    activate E
    E-->>C: expense records
    deactivate E
    C->>U: showFinances(orders, paidSales, expenses)
    activate U
    U-->>C: report displayed
    deactivate U
    deactivate C
