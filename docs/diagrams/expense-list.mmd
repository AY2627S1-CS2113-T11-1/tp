%%{init: {"sequence": {"mirrorActors": false}, "themeCSS": ".actor-line { stroke-dasharray: 5 5; }", "themeVariables": {"fontSize": "20px", "actorBkg": "#eef4fb", "actorBorder": "#40566f", "actorTextColor": "#1f2933", "actorLineColor": "#8a98a8", "signalColor": "#40566f", "signalTextColor": "#1f2933", "activationBkgColor": "#ffffff", "activationBorderColor": "#40566f"}}}%%
sequenceDiagram
    participant C as command : ListExpenseCommand
    participant L as expenses : ExpenseList
    participant U as ui : Ui

    activate C
    C->>L: getExpenses()
    activate L
    L-->>C: copy of expense records
    deactivate L
    C->>U: showExpenses(expenses)
    activate U
    U-->>C: list displayed
    deactivate U
    deactivate C
